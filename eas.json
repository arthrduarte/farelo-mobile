{
  "cli": {
    "version": ">= 15.0.10",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "bundleIdentifier": "com.arthrduarte.farelo.dev"
      },
      "android": {
        "package": "com.arthrduarte.farelo.dev",
        "adaptiveIcon": {
          "foregroundImage": "./assets/images/icon_android_dev.png"
        }
      }
    },
    "preview": {
      "ios": {
        "distribution": "store"
      },
      "android": {
        "distribution": "internal"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "development": {
      "ios":{
        "ascAppId": "6745767053"
      }
    },
    "preview":{
      "ios":{
        "ascAppId": "6745767053"
      }
    },
    "production": {
      "ios":{
        "ascAppId": "6745767053"
      }
    }
  }
}
